# Copy this file to .env and fill in your OpenAI key:
#   cp .env.example .env

OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo

EMBEDDING_MODEL=hkunlp/instructor-xl
EMBEDDING_DEVICE=cpu

# Docker Compose paths (override for local runs, e.g. ./data and ./chroma_db)
CHROMA_PERSIST_DIR=/app/chroma_db
DATA_DIR=/app/data

CHUNK_SIZE=100
CHUNK_OVERLAP=5
RETRIEVER_K=3
